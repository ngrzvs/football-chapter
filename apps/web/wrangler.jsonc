{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "football-chapter",
  "compatibility_date": "2026-07-21",
  "main": "worker/index.ts",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "football-chapter",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT_BUCKET",
      "bucket_name": "football-chapter-content"
    }
  ],
  "vars": {
    // Production fails closed when TURNSTILE_SECRET or HMAC_SECRET is absent.
    // For local-only bypass: wrangler dev --var ENVIRONMENT:development, then use token "dev-pass".
    "ENVIRONMENT": "production"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
