{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@football/protocol": ["packages/protocol/src/index.ts"],
      "@football/content": ["packages/content/src/index.ts"],
      "@football/engine": ["packages/engine/src/index.ts"]
    }
  }
}

